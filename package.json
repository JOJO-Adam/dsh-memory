{
  "name": "@jojonadam/dsh-memory",
  "version": "0.4.0",
  "description": "Three-layer memory for DeepSeek Harness with native memory tools, Cordis hooks, subagent briefs and memory metrics. 本地优先 · 零出站。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "locale"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "anti-drift",
    "persona",
    "stemem"
  ],
  "license": "MIT",
  "author": "JOJO & Adam",
  "homepage": "https://jojo-adam.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JOJO-Adam/dsh-memory.git"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/JOJO-Adam/dsh-memory/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "icon.svg",
  "scripts": {
    "test": "node test/provider.test.mjs && node test/tools.test.mjs && node test/hooks.test.mjs"
  }
}
